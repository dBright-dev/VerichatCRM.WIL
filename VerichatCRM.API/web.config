<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting configuration for the API.

  This file exists for one reason: stdoutLogEnabled. When the application fails
  to start, ANCM answers HTTP 500.30 and the browser sees nothing about why -
  the exception that Program.cs throws for a missing ConnectionStrings__DefaultConnection,
  a missing Jwt__Key or an Encrypt=False connection string never reaches the
  visitor, and without this log it never reaches anybody either. With it, the
  full exception is written to .\logs\stdout_<timestamp>.txt in the site folder
  and the cause is readable in the hosting file manager.

  processPath and arguments repeat what the SDK writes for this project
  (framework-dependent, in-process), so the published site keeps hosting exactly
  as it does today - only the logging switch changes.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\VerichatCRM.API.dll" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
