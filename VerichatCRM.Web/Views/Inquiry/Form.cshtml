@model VerichatCRM.Web.Models.Inquiry.InquiryFormViewModel

@{
    var isEdit = ViewData["IsEdit"] is true;
    var statuses = (string[])ViewData["AllStatuses"]!;
    var sources = (string[])ViewData["AllSources"]!;
    ViewData["Title"] = isEdit ? "Edit Inquiry" : "New Inquiry";
}

<div class="auth-card" style="max-width: 720px; margin: 0 auto;">
    <h1 class="auth-title">@(isEdit ? "Edit enquiry" : "Record an enquiry")</h1>

    <p class="auth-subtitle">
        The score decides where the enquiry sits in the queue — 100 is worked first.
    </p>

    <form asp-action="@(isEdit ? "Edit" : "Create")"
          method="post"
          asp-route-id="@Model.InquiryId">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-critical"></div>

        <div class="form-group">
            <label class="form-label" asp-for="Subject">Subject</label>
            <input asp-for="Subject"
                   class="form-input"
                   placeholder="What the client needs" />
            <span asp-validation-for="Subject" class="text-critical"></span>
        </div>

        <!-- Company dropdown -->
        <div class="form-group">
            <label class="form-label" asp-for="Company">Company</label>

            <select asp-for="ClientId"
                    id="ClientId"
                    class="form-select">

                <option value="">-- Select a company --</option>

                @foreach (var client in Model.Clients.OrderBy(c => c.Name))
                {
                    <option value="@client.Id"
                            data-company="@client.Name"
                            data-contact="@client.ContactPerson"
                            data-email="@client.ContactEmail"
                            data-phone="@client.ContactPhone">

                        @client.Name
                    </option>
                }
            </select>

            <input asp-for="Company" type="hidden" id="Company" />
            <span asp-validation-for="ClientId" class="text-critical"></span>
        </div>

        <!-- Contact dropdown -->
        <div class="form-group">
            <label class="form-label" asp-for="ContactName">Contact name</label>

            <select asp-for="ContactName"
                    id="ContactName"
                    class="form-select">

                <option value="">-- Select a contact --</option>
            </select>

            <span asp-validation-for="ContactName" class="text-critical"></span>
        </div>

        <!-- Contact email -->
        <div class="form-group">
            <label class="form-label" asp-for="ContactEmail">Email</label>

            <input asp-for="ContactEmail"
                   id="ContactEmail"
                   type="email"
                   class="form-input" />

            <span asp-validation-for="ContactEmail" class="text-critical"></span>
        </div>

        <!-- Contact phone -->
        <div class="form-group">
            <label class="form-label" asp-for="ContactPhone">Phone</label>

            <input asp-for="ContactPhone"
                   id="ContactPhone"
                   class="form-input" />

            <span asp-validation-for="ContactPhone" class="text-critical"></span>
        </div>

        <!-- Enquiry source -->
        <div class="form-group">
            <label class="form-label" asp-for="Source">Source</label>

            <select asp-for="Source" class="form-select">
                @foreach (var s in sources)
                {
                    <option value="@s">@s</option>
                }
            </select>

            <span asp-validation-for="Source" class="text-critical"></span>
        </div>

        <!-- Status: only shown when editing -->
        @if (isEdit)
        {
            <div class="form-group">
                <label class="form-label" asp-for="Status">Status</label>

                <select asp-for="Status" class="form-select">
                    @foreach (var s in statuses)
                    {
                        <option value="@s">@s</option>
                    }
                </select>

                <span class="form-hint">
                    Moving the status off &ldquo;New&rdquo; records that a response was sent.
                </span>

                <span asp-validation-for="Status" class="text-critical"></span>
            </div>
        }

        <!-- Enquiry score -->
        <div class="form-group">
            <label class="form-label" asp-for="Score">Score (0&ndash;100)</label>

            <input asp-for="Score"
                   type="number"
                   min="0"
                   max="100"
                   class="form-input" />

            <span class="form-hint">
                Higher scores are worked first.
            </span>

            <span asp-validation-for="Score" class="text-critical"></span>
        </div>

        <!-- Enquiry description -->
        <div class="form-group">
            <label class="form-label" asp-for="Description">Details</label>

            <textarea asp-for="Description"
                      class="form-control"
                      rows="4"></textarea>

            <span asp-validation-for="Description" class="text-critical"></span>
        </div>

        <!-- Internal notes: only shown when editing -->
        @if (isEdit)
        {
            <div class="form-group">
                <label class="form-label" asp-for="Notes">Internal notes</label>

                <textarea asp-for="Notes"
                          class="form-control"
                          rows="3"></textarea>

                <span asp-validation-for="Notes" class="text-critical"></span>
            </div>
        }

        <!-- Form buttons -->
        <div style="display:flex; gap:12px; margin-top:24px;">
            <button type="submit" class="btn btn-primary">
                @(isEdit ? "Save changes" : "Add to queue")
            </button>

            <a class="btn btn-secondary" asp-action="Index">Cancel</a>
        </div>
    </form>

    <!-- Delete enquiry: only shown when editing -->
    @if (isEdit)
    {
        <form asp-action="Delete"
              asp-route-id="@Model.InquiryId"
              method="post"
              style="margin-top:18px; border-top:1px solid #e2e5ea; padding-top:16px;"
              onsubmit="return confirm('Delete this enquiry permanently?');">

            @Html.AntiForgeryToken()

            <button type="submit" class="btn btn-danger">
                Delete enquiry
            </button>
        </form>
    }
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const companyDropdown = document.getElementById("ClientId");
        const contactDropdown = document.getElementById("ContactName");
        const companyInput = document.getElementById("Company");
        const emailInput = document.getElementById("ContactEmail");
        const phoneInput = document.getElementById("ContactPhone");

        // Remember the contact currently saved on the enquiry.
        const savedContact = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ContactName ?? ""));

        function updateContactDetails() {
            const selectedOption =
                companyDropdown.options[companyDropdown.selectedIndex];

            // Reset the contact dropdown.
            contactDropdown.innerHTML =
                '<option value="">-- Select a contact --</option>';

            if (!selectedOption || !selectedOption.value) {
                companyInput.value = "";
                emailInput.value = "";
                phoneInput.value = "";
                return;
            }

            const company = selectedOption.dataset.company || "";
            const contact = selectedOption.dataset.contact || "";
            const email = selectedOption.dataset.email || "";
            const phone = selectedOption.dataset.phone || "";

            // Keep the company name in sync with the selected company.
            companyInput.value = company;

            // Add the contact belonging to the selected company.
            if (contact) {
                const option = document.createElement("option");
                option.value = contact;
                option.textContent = contact;

                contactDropdown.appendChild(option);

                // Preserve the saved contact when editing an enquiry.
                if (contact === savedContact) {
                    option.selected = true;
                } else {
                    option.selected = true;
                }
            }

            // Fill in the selected contact's details.
            emailInput.value = email;
            phoneInput.value = phone;
        }

        // Update details whenever the company changes.
        companyDropdown.addEventListener("change", updateContactDetails);

        // Populate existing values when opening the form.
        updateContactDetails();
    });
</script>