@model VerichatCRM.Web.ViewModels.Procurement.ProductCatalogViewModel
@{
    ViewData["Title"] = "Product Catalog";
    ViewData["Subtitle"] = $"{Model.Products.Count} products";
}

@if (Perm.Has(Context.Session.GetString("UserRole") ?? "", Perm.ProductCreate))
{
    <div style="display:flex; justify-content:flex-end; margin-bottom:16px;">
        <a class="btn btn-primary" asp-action="ProductCreate">+ New product</a>
    </div>
}

<div class="chip-row">
    @foreach (var cat in Model.Categories)
    {
        <button class="chip @(cat == Model.ActiveCategory ? "active" : "")" data-category="@cat">@cat</button>
    }
</div>

<div class="catalog-toolbar">
    <div class="search-bar">
        <input type="text" placeholder="Search products or SKU..." id="catalogSearch" />
    </div>
    @* product-catalog.js re-orders the cards on change. The control used to carry
       no id, no values and no listener, so every choice here redrew nothing. *@
    <select class="form-select" style="max-width: 200px;" id="catalogSort" aria-label="Sort products">
        <option value="name-asc">Sort: Name A-Z</option>
        <option value="name-desc">Sort: Name Z-A</option>
        <option value="price-asc">Sort: Price Low-High</option>
        <option value="price-desc">Sort: Price High-Low</option>
        <option value="stock-asc">Sort: Stock Low-High</option>
    </select>
</div>

@if (Model.Products.Count == 0)
{
    <div class="empty-state" style="text-align:center; padding:56px 24px;">
        <h2 class="auth-title" style="font-size:1.25rem;">
            @(string.IsNullOrWhiteSpace(Model.SearchQuery) ? "No products yet" : "No products match your search")
        </h2>
        @if (Perm.Has(Context.Session.GetString("UserRole") ?? "", Perm.ProductCreate))
        {
            <p class="auth-subtitle">
                This catalogue is empty. Create the first product and it appears here and
                in the mobile app straight away.
            </p>
            <a class="btn btn-primary" asp-action="ProductCreate">+ Create the first product</a>
        }
        else
        {
            <p class="auth-subtitle">Products added by an administrator appear here.</p>
        }
    </div>
}

<div class="product-grid">
    @foreach (var p in Model.Products)
    {
        @* data-price is invariant-culture on purpose: the "R 1,234" text the card
           shows is a display string, and parsing that back would depend on the
           browser's locale. data-name is already lower-cased, so the sort compares
           like with like. *@
        <div class="product-card" data-category="@p.Category" data-name="@p.ProductName.ToLower()" data-sku="@p.SKU.ToLower()" data-price="@p.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-stock="@p.StockQty">
            <div class="product-image">
                @if (!string.IsNullOrWhiteSpace(p.ImageUrl))
                {
                    <img src="@p.ImageUrl" alt="@p.ProductName" onerror="this.style.display='none'; this.parentElement.classList.add('placeholder')" />
                }
                else if (CatalogueArt.ProductImageFor(p.ProductName) is { } photo)
                {
                    <img src="@photo" alt="@p.ProductName" onerror="this.style.display='none'; this.parentElement.classList.add('placeholder')" />
                }
                else if (CatalogueArt.ImageFor(p.Category) is { } art)
                {
                    <img src="@art" alt="" aria-hidden="true" onerror="this.style.display='none'; this.parentElement.classList.add('placeholder')" />
                }
            </div>
            <div class="product-body">
                <div class="product-name">@p.ProductName</div>
                <div class="product-price">R @p.Price.ToString("N0")</div>
                <div class="product-footer">
                    @* Same chip wording as the client portal's catalogue card; the
                       count the buyer wants sits beside it, not inside it. A zero-
                       stock line used to reach here with no word of its own. *@
                    @{ var stockLabel = Badge.StockLabel(p.StockQty, p.IsLowStock); }
                    <span class="badge @Badge.For(stockLabel)">@stockLabel</span>
                    <span class="product-stock">@p.StockQty on hand</span>
                </div>
                @if (Perm.Has(Context.Session.GetString("UserRole") ?? "", Perm.ProductEdit))
                {
                    <a class="product-edit" asp-action="ProductEdit" asp-route-sku="@p.SKU">Edit</a>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/product-catalog.js"></script>
}