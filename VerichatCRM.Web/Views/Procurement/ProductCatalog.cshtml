@model VerichatCRM.Web.ViewModels.Procurement.ProductCatalogViewModel
@{
    ViewData["Title"] = "Product Catalog";
    ViewData["Subtitle"] = $"{Model.Products.Count} products";
}

@if (Perm.Has(Context.Session.GetString("UserRole") ?? "", Perm.ProductCreate))
{
    <div style="display:flex; justify-content:flex-end; margin-bottom:16px;">
        <a class="btn btn-primary" asp-action="ProductCreate">+ New product</a>
    </div>
}

<div class="chip-row">
    @foreach (var cat in Model.Categories)
    {
        <button class="chip @(cat == Model.ActiveCategory ? "active" : "")" data-category="@cat">@cat</button>
    }
</div>

<div class="catalog-toolbar">
    <div class="search-bar">
        <input type="text" placeholder="Search products or SKU..." id="catalogSearch" />
    </div>
    <select class="form-select" style="max-width: 200px;">
        <option>Sort: Name A-Z</option>
        <option>Sort: Name Z-A</option>
        <option>Sort: Price Low-High</option>
        <option>Sort: Price High-Low</option>
        <option>Sort: Stock Low-High</option>
    </select>
</div>

@if (Model.Products.Count == 0)
{
    <div class="empty-state" style="text-align:center; padding:56px 24px;">
        <h2 class="auth-title" style="font-size:1.25rem;">
            @(string.IsNullOrWhiteSpace(Model.SearchQuery) ? "No products yet" : "No products match your search")
        </h2>
        @if (Perm.Has(Context.Session.GetString("UserRole") ?? "", Perm.ProductCreate))
        {
            <p class="auth-subtitle">
                This catalogue is empty. Create the first product and it appears here and
                in the mobile app straight away.
            </p>
            <a class="btn btn-primary" asp-action="ProductCreate">+ Create the first product</a>
        }
        else
        {
            <p class="auth-subtitle">Products added by an administrator appear here.</p>
        }
    </div>
}

<div class="product-grid">
    @foreach (var p in Model.Products)
    {
        <div class="product-card" data-category="@p.Category" data-name="@p.ProductName.ToLower()" data-sku="@p.SKU.ToLower()">
            <div class="product-image">
                @if (!string.IsNullOrWhiteSpace(p.ImageUrl))
                {
                    <img src="@p.ImageUrl" alt="@p.ProductName" onerror="this.style.display='none'; this.parentElement.classList.add('placeholder')" />
                }
            </div>
            <div class="product-body">
                <div class="product-name">@p.ProductName</div>
                <div class="product-price">R @p.Price.ToString("N0")</div>
                <div class="product-footer">
                    <span class="badge @(p.IsLowStock ? "badge-warning" : "badge-success")">
                        @(p.IsLowStock ? "Low Stock" : "In Stock")
                    </span>
                    <span class="product-stock">@p.StockQty in stock</span>
                </div>
                @if (Perm.Has(Context.Session.GetString("UserRole") ?? "", Perm.ProductEdit))
                {
                    <a class="product-edit" asp-action="ProductEdit" asp-route-sku="@p.SKU">Edit</a>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/product-catalog.js"></script>
}