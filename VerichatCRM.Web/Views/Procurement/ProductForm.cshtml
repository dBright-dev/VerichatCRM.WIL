@model VerichatCRM.Web.Models.Procurement.ProductViewModel
@{
    var isEdit = ViewData["IsEdit"] is true;
    ViewData["Title"] = isEdit ? "Edit Product" : "New Product";
}

<div class="auth-card" style="max-width: 720px; margin: 0 auto;">
    <h1 class="auth-title">@(isEdit ? "Edit product" : "New product")</h1>
    <p class="auth-subtitle">
        Saved products are published to the catalogue and appear in the mobile app
        for clients to browse and order.
    </p>

    <form asp-action="@(isEdit ? "ProductEdit" : "ProductCreate")"
          method="post"
          asp-route-sku="@Model.SKU">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-critical"></div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }

        <div class="form-group">
            <label class="form-label" asp-for="ProductName">Product name</label>
            <input asp-for="ProductName" class="form-input" placeholder="Surgical Mask - Type IIR Box 50" />
            <span asp-validation-for="ProductName" class="text-critical"></span>
        </div>

        <div class="form-group">
            <label class="form-label" asp-for="Category">Category</label>
            <input asp-for="Category" class="form-input" list="category-options"
                   placeholder="Type a category, e.g. PPE or Laboratory" />
            <datalist id="category-options">
                @foreach (var c in ViewContext.HttpContext.Request.Query["categories"].ToString()
                             .Split(',', StringSplitOptions.RemoveEmptyEntries))
                {
                    <option value="@c"></option>
                }
            </datalist>
            <span class="form-hint">
                Categories are free text so you are not limited to a fixed list.
            </span>
            <span asp-validation-for="Category" class="text-critical"></span>
        </div>

        <div class="form-group">
            <label class="form-label" asp-for="Price">Price</label>
            <input asp-for="Price" type="number" step="0.01" min="0" class="form-input" />
            <span asp-validation-for="Price" class="text-critical"></span>
        </div>

        @if (!isEdit)
        {
            <div class="form-group">
                <label class="form-label" asp-for="StockQty">Opening stock</label>
                <input asp-for="StockQty" type="number" min="0" class="form-input" />
                <span asp-validation-for="StockQty" class="text-critical"></span>
            </div>
        }

        <div class="form-group">
            <label class="form-label" asp-for="LowStockThreshold">Low-stock threshold</label>
            <input asp-for="LowStockThreshold" type="number" min="0" class="form-input" />
            <span class="form-hint">
                A warehouse alert is raised automatically when stock falls to this level.
            </span>
            <span asp-validation-for="LowStockThreshold" class="text-critical"></span>
        </div>

        <div class="form-group">
            <label class="form-label" asp-for="ImageUrl">Image URL</label>
            <input asp-for="ImageUrl" type="url" class="form-input"
                   placeholder="https://example.com/products/mask.jpg" />
            <span class="form-hint">
                Paste a link to an image. Leave blank for no image.
            </span>
            <span asp-validation-for="ImageUrl" class="text-critical"></span>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
        {
            <div class="form-group">
                <label class="form-label">Current image</label>
                <img src="@Model.ImageUrl" alt="@Model.ProductName"
                     style="max-width: 220px; max-height: 160px; object-fit: contain;
                            border: 1px solid #e2e5ea; border-radius: 10px; padding: 6px;"
                     onerror="this.style.display='none';" />
            </div>
        }

        <div style="display:flex; gap:12px; margin-top: 24px;">
            <button type="submit" class="btn btn-primary">
                @(isEdit ? "Save changes" : "Create product")
            </button>
            <a class="btn btn-secondary" asp-action="ProductCatalog">Cancel</a>
        </div>
    </form>
</div>