@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="stat-grid">
    <div class="stat-card">
        <div class="stat-accent cyan"></div>
        <div class="stat-label">Active Users</div>
        <div class="stat-value">—</div>
    </div>
    <div class="stat-card">
        <div class="stat-accent orange"></div>
        <div class="stat-label">System Load</div>
        <div class="stat-value">—</div>
    </div>
    <div class="stat-card">
        <div class="stat-accent red"></div>
        <div class="stat-label">Error Rate</div>
        <div class="stat-value">—</div>
    </div>
    <div class="stat-card">
        <div class="stat-accent green"></div>
        <div class="stat-label">Active Sessions</div>
        <div class="stat-value">—</div>
    </div>
</div>

<div class="card">
    <div class="card-title">System Administration</div>
    <p class="vc-text-muted">Analytics, users, roles, and security rules will appear here.</p>
</div>