@model VerichatCRM.Core.Models.Dashboard.DashboardAnalyticsResponse
@{
    ViewData["Title"] = "Analytics";
}
<div class="stat-grid">
    @foreach (var kpi in Model.Kpis) { <div class="stat-card"><div class="stat-label">@kpi.Label</div><div class="stat-value vc-accent">@kpi.Value</div><div class="stat-meta">@kpi.DeltaLabel</div></div> }
</div>
<div class="card"><div class="card-title">Monthly order value</div><canvas id="analyticsRevenue" height="120"></canvas></div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        (function () {
            var el = document.getElementById('analyticsRevenue');
            if (!el || typeof Chart === 'undefined') return;
            const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueTrend.Select(x => x.Label)));
            const values = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueTrend.Select(x => x.Value)));
            new Chart(el, { type: 'line', data: { labels, datasets: [{ label: 'Order value (R)', data: values, borderColor: '#5B5BD6', fill: true }] }, options: { responsive: true } });
        })();
    </script>
}
