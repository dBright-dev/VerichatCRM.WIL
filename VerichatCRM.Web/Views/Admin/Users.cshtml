@model List<VerichatCRM.Web.Services.Interfaces.UserListItem>
@using VerichatCRM.Core.Entities
@{
    ViewData["Title"] = "Users & Roles";
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert-banner"><span class="alert-icon">✓</span><span>@TempData["SuccessMessage"]</span></div>
}
<div class="card">
    <div class="card-title">All Users (@Model.Count)</div>
    <p class="vc-text-muted">Only System Administrators can change roles or deactivate users. New accounts are created by the person who signs up, or by the bootstrap administrator on a first run; this screen changes existing ones.</p>
    <table class="data-table">
        <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Last login</th><th></th></tr></thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td><strong>@u.DisplayName</strong></td>
                    <td>@u.Email</td>
                    <td>
                        <form asp-action="UpdateUserRole" method="post" style="display:flex;gap:.4rem;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@u.UserId" />
                            <select name="role" class="form-select form-select-sm">
                                @* The list is UserRoles.All, not a copy typed into
                                    this view: it used to offer four of the seven
                                    roles, so Logistics, Client User and Medical
                                    Student accounts existed in the database but
                                    could never be granted or corrected here.
                                    Saving to a client-audience role moves them to
                                    the portal (/portal) on the web and their own
                                    homescreen in the mobile app. *@
                                @foreach (var r in UserRoles.All)
                                {
                                    <option value="@r" selected="@(r == u.Role)">@r</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-outline btn-xs">Save</button>
                        </form>
                    </td>
                    <td><span class="badge @(u.IsActive ? "badge-success" : "badge-neutral")">@(u.IsActive ? "Active" : "Inactive")</span></td>
                    <td>@(u.LastLoginAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                    <td>
                        @if (u.IsActive)
                        {
                            <form asp-action="DeactivateUser" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="userId" value="@u.UserId" />
                                <button type="submit" class="btn btn-danger btn-xs">Deactivate</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div class="card" style="margin-top:1rem;">
    <div class="card-title">SLA Control</div>
    <p class="vc-text-muted">Manually trigger the SLA escalation job (normally runs every 5 minutes).</p>
    <form asp-action="RunSlaCheck" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-primary btn-sm">Run SLA check now</button>
    </form>
</div>
