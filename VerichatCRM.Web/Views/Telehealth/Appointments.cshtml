@model IReadOnlyList<VerichatCRM.Web.Models.Telehealth.TelehealthAppointmentViewModel>

<section class="card">
    <div class="card-header">
        <h2>Client appointment requests</h2>
        <span>@Model.Count appointments</span>
    </div>
    @if (Model.Count == 0)
    {
        <div class="empty-state" style="padding:32px 16px; text-align:center;">
            <p>No mobile appointments have been booked yet.</p>
        </div>
    }
    else
    {
        <div style="overflow-x:auto;">
            <table class="table">
                <thead>
                    <tr><th>Client</th><th>Appointment</th><th>Provider</th><th>Facility</th><th>Status</th><th>Requested</th></tr>
                </thead>
                <tbody>
                    @foreach (var appointment in Model)
                    {
                        <tr>
                            <td><strong>@appointment.ClientName</strong><br /><small>@appointment.ClientUserId</small></td>
                            <td>@appointment.StartsAt.ToLocalTime().ToString("ddd, d MMM yyyy · HH:mm")</td>
                            <td>@appointment.DoctorName<br /><small>@appointment.Specialty</small></td>
                            <td>@appointment.Facility</td>
                            <td><span class="badge">@appointment.Status</span></td>
                            <td>@appointment.CreatedAt.ToLocalTime().ToString("d MMM yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
