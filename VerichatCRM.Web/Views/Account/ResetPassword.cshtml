@model VerichatCRM.Web.Models.Auth.ResetPasswordRequest
@{
    ViewData["Title"] = "Choose a new password";
    Layout = "_AuthLayout";
}

<section class="vc-auth">
    <aside class="vc-auth-side">
        <div class="vc-auth-brand">
            <img class="vc-auth-logo" src="~/images/logo.png" width="40" height="40" alt="Verichat logo" />
            <div>
                <div class="vc-auth-brand-name">Verichat</div>
                <div class="vc-auth-brand-sub">MEDICAL PROCUREMENT</div>
            </div>
        </div>
        <h2 class="vc-auth-headline">This link<br />ends here.</h2>
        <p class="vc-auth-lede">Set a password you have not used on this account before. The moment it is saved, the link that got you here is spent - a second copy of the email buys nothing.</p>
        <ul class="vc-auth-points">
            <li><span class="vc-check">✓</span> Eight characters is the minimum; a phrase is easier to keep</li>
            <li><span class="vc-check">✓</span> Your password is stored as a one-way hash, never as text</li>
            <li><span class="vc-check">✓</span> Nothing else about the account changes</li>
        </ul>

        @await Html.PartialAsync("_AuthPolicyFootnote")
    </aside>

    <div class="vc-auth-main">
        <div class="vc-auth-card">
            <h1 class="vc-auth-title">New password</h1>
            <p class="vc-auth-sub">You opened a reset link. Choose what the password becomes.</p>

            <form asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="Token" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="text-critical"></div>

                <div class="form-group">
                    <label class="form-label" asp-for="NewPassword">New password</label>
                    <input asp-for="NewPassword" type="password" class="form-input" placeholder="At least 8 characters" autocomplete="new-password" autofocus />
                    <span asp-validation-for="NewPassword" class="text-critical"></span>
                </div>

                <div class="form-group">
                    <label class="form-label" asp-for="ConfirmPassword">Confirm new password</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-input" placeholder="Type it again" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-critical"></span>
                </div>

                <button type="submit" class="btn btn-primary btn-block">Change my password</button>

                <p class="vc-auth-switch">
                    Link arrived by mistake? <a asp-action="Login">Back to sign in</a>
                </p>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
