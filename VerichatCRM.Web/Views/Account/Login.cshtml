@model VerichatCRM.Web.Models.Auth.LoginRequest
@{
    ViewData["Title"] = "Sign in";
    Layout = "_AuthLayout";
}

<section class="vc-auth">
    <aside class="vc-auth-side">
        <div class="vc-auth-brand">
            <img class="vc-auth-logo" src="~/images/logo.png" width="40" height="40" alt="Verichat logo" />
            <div>
                <div class="vc-auth-brand-name">Verichat</div>
                <div class="vc-auth-brand-sub">MEDICAL PROCUREMENT</div>
            </div>
        </div>
        <h2 class="vc-auth-headline">Precision procurement<br />for the health sector.</h2>
        <p class="vc-auth-lede">One platform for the supply chain: clinical consumables, rehab equipment, the deliveries that move them and the support that keeps them running.</p>
        <ul class="vc-auth-points">
            <li><span class="vc-check">✓</span> AI-scored inquiry queue</li>
            <li><span class="vc-check">✓</span> SLA-tracked ticket resolution</li>
            <li><span class="vc-check">✓</span> Quotations your clients can answer</li>
        </ul>

        @await Html.PartialAsync("_AuthPolicyFootnote")
    </aside>

    <div class="vc-auth-main">
        <div class="vc-auth-card">
            <h1 class="vc-auth-title">Sign in</h1>
            <p class="vc-auth-sub">Use the work address your account was created with.</p>

            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-critical"></div>

                <div class="form-group">
                    <label class="form-label" asp-for="Email">Email address</label>
                    <input asp-for="Email" type="email" class="form-input" placeholder="you@example.com" autocomplete="email" autofocus />
                    <span asp-validation-for="Email" class="text-critical"></span>
                </div>

                <div class="form-group">
                    <label class="form-label" asp-for="Password">Password</label>
                    <input asp-for="Password" type="password" class="form-input" placeholder="Your password" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-critical"></span>
                </div>

                <button type="submit" class="btn btn-primary btn-block">Sign in</button>

                <p class="vc-auth-switch">
                    Forgotten the password? <a asp-action="ForgotPassword">Send me a reset link</a>
                </p>

                @* The other way out. A reset link is no help to an account that is
                   declined, deactivated or mislabelled, and a person with none of the
                   three has previously had nowhere to say so except a phone number. *@
                <p class="vc-auth-switch">
                    Cannot get in at all? <a asp-action="Help">Tell an administrator</a>
                </p>

                <p class="vc-auth-switch">
                    No account yet? <a asp-action="Register">Create one</a>
                </p>
            </form>

            @await Html.PartialAsync("_DemoQuickLogin")
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
