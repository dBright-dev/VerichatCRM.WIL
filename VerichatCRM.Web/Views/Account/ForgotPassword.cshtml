@model VerichatCRM.Web.Models.Auth.ForgotPasswordRequest
@{
    ViewData["Title"] = "Forgotten password";
    Layout = "_AuthLayout";
}

<section class="vc-auth">
    <aside class="vc-auth-side">
        <div class="vc-auth-brand">
            <img class="vc-auth-logo" src="~/images/logo.png" width="40" height="40" alt="Verichat logo" />
            <div>
                <div class="vc-auth-brand-name">Verichat</div>
                <div class="vc-auth-brand-sub">MEDICAL PROCUREMENT</div>
            </div>
        </div>
        <h2 class="vc-auth-headline">One link,<br />one hour.</h2>
        <p class="vc-auth-lede">A reset link is written for one use and stops working after an hour. It never carries your password, and choosing a new one through it is the only thing it can do.</p>
        <ul class="vc-auth-points">
            <li><span class="vc-check">✓</span> The link replaces the password; it does not show the old one</li>
            <li><span class="vc-check">✓</span> Requesting one does not touch your account until you use it</li>
            <li><span class="vc-check">✓</span> An account still waiting for approval keeps waiting</li>
        </ul>

        @await Html.PartialAsync("_AuthPolicyFootnote")
    </aside>

    <div class="vc-auth-main">
        <div class="vc-auth-card">
            <h1 class="vc-auth-title">Reset your password</h1>
            <p class="vc-auth-sub">Enter the address your account was created with.</p>

            <form asp-action="ForgotPassword" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-critical"></div>

                <div class="form-group">
                    <label class="form-label" asp-for="Email">Email address</label>
                    <input asp-for="Email" type="email" class="form-input" placeholder="you@example.com" autocomplete="email" autofocus />
                    <span asp-validation-for="Email" class="text-critical"></span>
                </div>

                <button type="submit" class="btn btn-primary btn-block">Send me a reset link</button>

                <p class="vc-auth-note">
                    If the address has no Verichat account, nothing is sent. That is the
                    same answer this form gives either way, so it cannot be used to find
                    out who has an account.
                </p>

                <p class="vc-auth-switch">
                    Remembered it after all? <a asp-action="Login">Sign in</a>
                </p>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
