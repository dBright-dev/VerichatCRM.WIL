@model VerichatCRM.Web.Models.Auth.RegisterRequest
@{
    ViewData["Title"] = "Register";
    Layout = "_AuthLayout";
}

<section class="vc-auth">
    <aside class="vc-auth-side">
        <div class="vc-auth-brand">
            <img class="vc-auth-logo" src="~/images/logo.png" width="40" height="40" alt="Verichat logo" />
            <div>
                <div class="vc-auth-brand-name">Verichat</div>
                <div class="vc-auth-brand-sub">MEDICAL PROCUREMENT</div>
            </div>
        </div>
        <h2 class="vc-auth-headline">Create an account<br />and get to work.</h2>
        <p class="vc-auth-lede">Choose how you use Verichat. Staff roles run the supply chain from the console; client roles order from it and follow their own quotes, deliveries and support.</p>
        <ul class="vc-auth-points">
            <li><span class="vc-check">✓</span> Staff consoles for sales, procurement, support and logistics</li>
            <li><span class="vc-check">✓</span> A self-service portal for clients and students</li>
            <li><span class="vc-check">✓</span> One login for the web app and the mobile app</li>
        </ul>
    </aside>

    <div class="vc-auth-main">
        <div class="vc-auth-card">
            <h1 class="vc-auth-title">Create account</h1>
            <p class="vc-auth-sub">All fields are required except where marked.</p>
            <p class="vc-auth-sub">
                A Verichat employee reads every application before these credentials open
                anything, so sign in again once you have been approved. We also send a link
                to confirm this address is yours - clicking it is what tells the reviewer
                the notice will reach you.
            </p>

            <form asp-action="Register" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-critical"></div>

                <div class="form-group">
                    <label class="form-label" asp-for="DisplayName">Full name</label>
                    <input asp-for="DisplayName" class="form-input" placeholder="e.g. Thabo Nkosi" autocomplete="name" autofocus />
                    <span asp-validation-for="DisplayName" class="text-critical"></span>
                </div>

                <div class="form-group">
                    <label class="form-label" asp-for="Email">Email address</label>
                    <input asp-for="Email" type="email" class="form-input" placeholder="you@verichat.co.za" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-critical"></span>
                </div>

                <div class="form-group">
                    <label class="form-label" asp-for="Password">Password</label>
                    <input asp-for="Password" type="password" class="form-input" placeholder="At least 8 characters" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="text-critical"></span>
                </div>

                <div class="form-group">
                    <label class="form-label" asp-for="Role">What will you do here?</label>
                    <select asp-for="Role" class="form-select">
                        <optgroup label="Order from Verichat">
                            <option value="Client User">Client User — buy, request quotes, raise support</option>
                            <option value="Medical Student">Medical Student — browse and request, no purchasing</option>
                        </optgroup>
                        <optgroup label="Work inside Verichat">
                            <option value="Sales Representative">Sales Representative — revenue engine</option>
                            <option value="Procurement Manager">Procurement Manager — supply &amp; logistics</option>
                            <option value="Field Support Engineer">Field Support Engineer — on-site resolution</option>
                            <option value="Logistics">Logistics — delivery &amp; transport</option>
                        </optgroup>
                    </select>
                    <span asp-validation-for="Role" class="text-critical"></span>
                    <p class="vc-auth-sub" style="margin:.5rem 0 0;">
                        System Administrator is not on this list. It is granted by an
                        existing administrator, never claimed from a public form.
                    </p>
                </div>

                <button type="submit" class="btn btn-primary btn-block">Create account</button>

                <p class="vc-auth-switch">
                    Already have an account? <a asp-action="Login">Sign in</a>
                </p>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
