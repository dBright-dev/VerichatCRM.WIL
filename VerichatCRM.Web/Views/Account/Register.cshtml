@model VerichatCRM.Web.Models.Auth.RegisterRequest
@{
    ViewData["Title"] = "Register";
    Layout = "_Layout";
}

<section class="hero">
    <div class="hero-grid">
        <div class="hero-left">
            <div class="hero-brand">
                <img src="~/images/logo.png" alt="Verichat" />
            </div>
            <h2 class="hero-tagline">MEDICAL PROCUREMENT</h2>
            <div class="hero-divider"></div>
            <p class="hero-subtext">
                Create your account to access the Verichat CRM platform.
            </p>
        </div>

        <div class="hero-right">
            <div class="auth-card">
                <h1 class="auth-title">Create Account</h1>
                <p class="auth-subtitle">Join the Verichat CRM platform</p>

                <form asp-action="Register" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-critical"></div>

                    <div class="form-group">
                        <label class="form-label">Full Name</label>
                        <input asp-for="DisplayName" class="form-input" placeholder="e.g. Thabo Nkosi" />
                        <span asp-validation-for="DisplayName" class="text-critical"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Email Address</label>
                        <input asp-for="Email" type="email" class="form-input" placeholder="you@verichat.co.za" />
                        <span asp-validation-for="Email" class="text-critical"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Password</label>
                        <input asp-for="Password" type="password" class="form-input" placeholder="Min. 8 characters" />
                        <span asp-validation-for="Password" class="text-critical"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Role</label>
                        <select asp-for="Role" class="form-select">
                            <option value="System Administrator">System Administrator</option>
                            <option value="Sales Representative">Sales Representative</option>
                            <option value="Procurement Manager">Procurement Manager</option>
                            <option value="Field Support Engineer">Field Support Engineer</option>
                            <option value="Medical Student">Medical Student</option>
                        </select>
                        <span asp-validation-for="Role" class="text-critical"></span>
                    </div>

                    <button type="submit" class="btn btn-primary btn-block">Create Account</button>
                </form>

                <p style="text-align:center; margin-top: var(--space-lg); font-size: 13px;">
                    Already have an account? <a href="/account/login">Sign in</a>
                </p>
            </div>
        </div>
    </div>
</section>