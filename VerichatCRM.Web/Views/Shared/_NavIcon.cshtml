@model string
@*
    Inline stroke icons for the sidebar and the sign-out row.

    These replace the emoji that used to sit in .vc-sidebar__icon. Emoji are
    rendered by the operating system's colour font, so the same glyph differed on
    every machine, could not inherit the link's colour, and made a hovered or
    active row look no different from a resting one. Every path here is drawn on a
    24 by 24 grid with currentColor, which is what lets one CSS rule recolour the
    icon with its label.
*@
<svg class="vc-nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none"
     stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="true" focusable="false">
@switch (Model)
{
    case "board":
        <rect x="3" y="3" width="7" height="7" rx="1.5" />
        <rect x="14" y="3" width="7" height="7" rx="1.5" />
        <rect x="14" y="14" width="7" height="7" rx="1.5" />
        <rect x="3" y="14" width="7" height="7" rx="1.5" />
        break;
    case "workspace":
        <line x1="18" y1="20" x2="18" y2="10" />
        <line x1="12" y1="20" x2="12" y2="4" />
        <line x1="6" y1="20" x2="6" y2="14" />
        break;
    case "home":
        <path d="M3 10.2 12 3l9 7.2V20a1.8 1.8 0 0 1-1.8 1.8H4.8A1.8 1.8 0 0 1 3 20z" />
        <path d="M9.5 21.8V14h5v7.8" />
        break;
    case "package":
        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
        <polyline points="3.3 7 12 12 20.7 7" />
        <line x1="12" y1="22" x2="12" y2="12" />
        break;
    case "file":
        <path d="M14 2.5H6.8A1.8 1.8 0 0 0 5 4.3v15.4a1.8 1.8 0 0 0 1.8 1.8h10.4A1.8 1.8 0 0 0 19 19.7V7.5z" />
        <polyline points="14 2.5 14 7.5 19 7.5" />
        <line x1="15.5" y1="13" x2="8.5" y2="13" />
        <line x1="15.5" y1="17" x2="8.5" y2="17" />
        break;
    case "ticket":
        <path d="M3 8.5A2.5 2.5 0 0 0 5.5 6h13A2.5 2.5 0 0 0 21 8.5v1.7a2.3 2.3 0 0 1 0 4.6v1.7a2.5 2.5 0 0 0-2.5 2.5h-13A2.5 2.5 0 0 0 3 16.5v-1.7a2.3 2.3 0 0 1 0-4.6z" />
        <line x1="12" y1="9" x2="12" y2="15" />
        break;
    case "users":
        <path d="M16.5 21v-2a4 4 0 0 0-4-4H5.5a4 4 0 0 0-4 4v2" />
        <circle cx="9" cy="7" r="4" />
        <path d="M22.5 21v-2a4 4 0 0 0-3-3.87" />
        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
        break;
    case "wrench":
        <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94z" />
        break;
    case "calendar":
        <rect x="3" y="4.5" width="18" height="17" rx="2" />
        <line x1="16" y1="2.5" x2="16" y2="6.5" />
        <line x1="8" y1="2.5" x2="8" y2="6.5" />
        <line x1="3" y1="10.5" x2="21" y2="10.5" />
        break;
    case "inbox":
        <polyline points="21.5 12.5 16 12.5 14 15.5 10 15.5 8 12.5 2.5 12.5" />
        <path d="M5.4 5.1 2.5 12.5V19a2 2 0 0 0 2 2h15a2 2 0 0 0 2-2v-6.5L18.6 5.1a2 2 0 0 0-1.8-1.1H7.2a2 2 0 0 0-1.8 1.1z" />
        break;
    case "target":
        <circle cx="12" cy="12" r="9" />
        <circle cx="12" cy="12" r="5" />
        <circle cx="12" cy="12" r="1.4" />
        break;
    case "map-pin":
        <path d="M20.5 10.2c0 6.8-8.5 12.6-8.5 12.6S3.5 17 3.5 10.2a8.5 8.5 0 1 1 17 0z" />
        <circle cx="12" cy="10" r="3" />
        break;
    case "kanban":
        <rect x="3" y="3.5" width="5.5" height="17" rx="1.5" />
        <rect x="9.75" y="3.5" width="5.5" height="11.5" rx="1.5" />
        <rect x="16.5" y="3.5" width="5.5" height="14.5" rx="1.5" />
        break;
    case "chart":
        <polyline points="21.5 6.5 13.5 14.5 9 10 2.5 16.5" />
        <polyline points="16 6.5 21.5 6.5 21.5 12" />
        break;
    case "tag":
        <path d="M20.6 12.3 12.3 4H4v8.3l8.3 8.3a2 2 0 0 0 2.8 0l5.5-5.5a2 2 0 0 0 0-2.8z" />
        <circle cx="7.8" cy="7.8" r="1.4" />
        break;
    case "truck":
        <rect x="1.5" y="5.5" width="13" height="11" rx="1.5" />
        <path d="M14.5 9.5h3.6l3.4 3.4v3.6h-7z" />
        <circle cx="6" cy="18.5" r="2" />
        <circle cx="17.5" cy="18.5" r="2" />
        break;
    case "alert":
        <path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" />
        <line x1="12" y1="9.5" x2="12" y2="13.5" />
        <line x1="12" y1="17" x2="12.01" y2="17" />
        break;
    case "help":
        <circle cx="12" cy="12" r="9" />
        <path d="M9.2 9.2a3 3 0 0 1 5.8 1c0 2-3 3-3 3" />
        <line x1="12" y1="17" x2="12.01" y2="17" />
        break;
    case "user-cog":
        <path d="M15 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
        <circle cx="8" cy="7" r="4" />
        <circle cx="18" cy="14" r="2.6" />
        <path d="M18 10.2v-1.4M18 19.2v-1.4M21.8 14h1.4M12.8 14h1.4M20.7 11.3l1-1M14.3 16.7l1-1M20.7 16.7l1 1M14.3 11.3l1 1" />
        break;
    case "sliders":
        <line x1="4" y1="21" x2="4" y2="14" />
        <line x1="4" y1="10" x2="4" y2="3" />
        <line x1="12" y1="21" x2="12" y2="12" />
        <line x1="12" y1="8" x2="12" y2="3" />
        <line x1="20" y1="21" x2="20" y2="16" />
        <line x1="20" y1="12" x2="20" y2="3" />
        <line x1="1" y1="14" x2="7" y2="14" />
        <line x1="9" y1="8" x2="15" y2="8" />
        <line x1="17" y1="16" x2="23" y2="16" />
        break;
    case "logout":
        <path d="M9.5 21H5.8A1.8 1.8 0 0 1 4 19.2V4.8A1.8 1.8 0 0 1 5.8 3h3.7" />
        <polyline points="16 16.5 20.5 12 16 7.5" />
        <line x1="20.5" y1="12" x2="9.5" y2="12" />
        break;
}
</svg>
