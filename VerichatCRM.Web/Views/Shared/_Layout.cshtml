<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} · Verichat CRM" : "Verichat CRM")</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/verichat-theme.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @* Keyboard/screen-reader users can jump straight past the sidebar nav *@
    <a class="vc-skip-link" href="#main-content">Skip to main content</a>

    <div class="d-flex" style="min-height: 100vh;">

        @* Sidebar partial — added in the next commit. Layout references it now
           so this file doesn't need to change again once it lands. *@
        @await Html.PartialAsync("_Sidebar")

        <div class="flex-grow-1 d-flex flex-column">

            <header class="vc-topbar" role="banner">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <div class="vc-topbar__greeting">
                            @(ViewData["Title"] ?? "Dashboard")
                        </div>
                        @if (ViewData["Subtitle"] != null)
                        {
                            <div class="vc-topbar__meta">@ViewData["Subtitle"]</div>
                        }
                    </div>

                    <div class="d-flex align-items-center gap-3">
                        @* Placeholder for the signed-in user badge until auth (backend phase) is wired up *@
                        <span class="vc-badge vc-badge--accent" aria-label="Current role">
                            @(ViewData["CurrentRole"] ?? "Sales Rep")
                        </span>
                    </div>
                </div>
            </header>

            <main id="main-content" role="main" class="flex-grow-1 p-4" tabindex="-1">
                @RenderBody()
            </main>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
