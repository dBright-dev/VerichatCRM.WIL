@{
    // One home per screen: the link that is the page you are on is marked, so the
    // sidebar answers "where am I" as well as "where can I go". The theme styles
    // [aria-current="page"] identically to the .active class it already honoured.
    string? Curr(string ctrl, string act) =>
        string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), ctrl, StringComparison.OrdinalIgnoreCase)
        && string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), act, StringComparison.OrdinalIgnoreCase)
            ? "page" : null;
}
<aside class="vc-sidebar" id="vcSidebar">
    <a class="vc-sidebar__brand" asp-controller="Home" asp-action="Index" aria-current="@Curr("Home", "Index")">
        <img class="vc-brand-logo" src="~/images/logo.png" width="32" height="32" alt="Verichat logo" />
        <span><span class="vc-brand-text">Verichat</span><span class="vc-brand-sub">MEDICAL PROCUREMENT</span></span>
    </a>

    <div class="vc-sidebar__user">
        @{
            string? userName = "";
            string? userRole = "";
            if (ViewContext.HttpContext.Session != null && ViewContext.HttpContext.Session.Keys.Contains("UserName"))
            {
                userName = ViewContext.HttpContext.Session.GetString("UserName");
            }
            if (ViewContext.HttpContext.Session != null && ViewContext.HttpContext.Session.Keys.Contains("UserRole"))
            {
                userRole = ViewContext.HttpContext.Session.GetString("UserRole");
            }
        }
        <!-- Session values are absent before login, so test for empty as well as
             null: Substring on the "" defaults below threw on every anonymous page. -->
        <div class="vc-avatar">@(string.IsNullOrEmpty(userName) ? "V" : userName.Substring(0, 1))</div>
        <div>
            <div class="vc-user-name">@(string.IsNullOrEmpty(userName) ? "Verichat User" : userName)</div>
            <div class="vc-user-role">@(string.IsNullOrEmpty(userRole) ? "GUEST" : userRole.ToUpper())</div>
        </div>
    </div>

    @{
        string? role = "";
        if (ViewContext.HttpContext.Session != null && ViewContext.HttpContext.Session.Keys.Contains("UserRole"))
        {
            role = ViewContext.HttpContext.Session.GetString("UserRole");
        }
        bool Can(string permission) => Perm.Has(role, permission);

        var isAdmin = Can(Perm.AdminDashboard);
        var isSales = Can(Perm.SalesDashboard);
        var isProcurement = Can(Perm.ProcurementDashboard);
        var isSupport = Can(Perm.SupportDashboard);
        var isClient = Can(Perm.ClientPortal);
    }

    <nav class="vc-sidebar__nav" aria-label="Primary">

        <div class="vc-sidebar__section-label">OVERVIEW</div>

        @* Each role's home is its own screen; no two roles land on the same one.
            See DESIGN-SYSTEM.md 4 for the contract this ordering implements. *@
        @if (isAdmin)
        {
            <a class="vc-sidebar__link"
               asp-controller="Admin"
               asp-action="Dashboard"
               aria-current="@Curr("Admin", "Dashboard")">
                <span class="vc-sidebar__icon">▦</span>
                Admin Dashboard
            </a>
        }
        else if (isProcurement)
        {
            <a class="vc-sidebar__link"
               asp-controller="Procurement"
               asp-action="Dashboard"
               aria-current="@Curr("Procurement", "Dashboard")">
                <span class="vc-sidebar__icon">▦</span>
                Stock Dashboard
            </a>
        }
        else if (Can(Perm.LogisticsTracker))
        {
            // Logistics reads its own dispatch board. The gate is the permission
            // this user actually holds rather than a role string, because a Field
            // Support Engineer and Logistics share support.dashboard — matching on
            // the permission is what separates their two homes.
            <a class="vc-sidebar__link"
               asp-controller="Logistics"
               asp-action="Dashboard"
               aria-current="@Curr("Logistics", "Dashboard")">
                <span class="vc-sidebar__icon">▦</span>
                Dispatch Dashboard
            </a>
        }
        else if (isSupport)
        {
            <a class="vc-sidebar__link"
               asp-controller="Support"
               asp-action="Dashboard"
               aria-current="@Curr("Support", "Dashboard")">
                <span class="vc-sidebar__icon">▦</span>
                Support Dashboard
            </a>
        }
        else if (isSales)
        {
            @* A Sales Representative's home is the pipeline, not a second analytics
               board: RoleHome sends them here after sign-in, and the pipeline is the
               screen they act on. The generic workspace board stays reachable under
               the Workspace entry below for the roles whose home it is. *@
            <a class="vc-sidebar__link"
               asp-controller="Pipeline"
               asp-action="Index"
               aria-current="@Curr("Pipeline", "Index")">
                <span class="vc-sidebar__icon">▦</span>
                Pipeline Board
            </a>
        }
        else if (isClient)
        {
            @* The portal is the client audience's dashboard: their own quotations,
               deliveries and tickets, and nothing belonging to anyone else. *@
            <a class="vc-sidebar__link"
               asp-controller="Portal"
               asp-action="Index"
               aria-current="@Curr("Portal", "Index")">
                <span class="vc-sidebar__icon">▦</span>
                My Verichat
            </a>
        }

        @if (Can(Perm.Workspace))
        {
            <a class="vc-sidebar__link"
               asp-controller="Dashboard"
               asp-action="Index"
               aria-current="@Curr("Dashboard", "Index")">
                <span class="vc-sidebar__icon">▨</span>
                Workspace Analytics
            </a>
        }

        @if (isClient)
        {
            <div class="vc-sidebar__section-label">MY ACCOUNT</div>
            <a class="vc-sidebar__link" asp-controller="Portal" asp-action="Catalogue" aria-current="@Curr("Portal", "Catalogue")"><span class="vc-sidebar__icon">📦</span> Catalogue</a>
            <a class="vc-sidebar__link" asp-controller="Portal" asp-action="Quotations" aria-current="@Curr("Portal", "Quotations")"><span class="vc-sidebar__icon">📄</span> My Quotations</a>
            <a class="vc-sidebar__link" asp-controller="Portal" asp-action="Tickets" aria-current="@Curr("Portal", "Tickets")"><span class="vc-sidebar__icon">🎫</span> Support</a>
        }

        @if (Can(Perm.ClientDirectory) || Can(Perm.AssetTracking) || Can(Perm.AppointmentManagement))
        {
            <div class="vc-sidebar__section-label">CLIENTS</div>
        }
        @if (Can(Perm.ClientDirectory))
        {
            <a class="vc-sidebar__link" asp-controller="Clients" asp-action="Index" aria-current="@Curr("Clients", "Index")"><span class="vc-sidebar__icon">👥</span> Client Directory</a>
        }
        @if (Can(Perm.AssetTracking))
        {
            <a class="vc-sidebar__link" asp-controller="Logistics" asp-action="Assets" aria-current="@Curr("Logistics", "Assets")"><span class="vc-sidebar__icon">🔧</span> Asset Tracking</a>
        }
        @if (Can(Perm.AppointmentManagement))
        {
            <a class="vc-sidebar__link" asp-controller="Telehealth" asp-action="Appointments" aria-current="@Curr("Telehealth", "Appointments")"><span class="vc-sidebar__icon">📅</span> Client Appointments</a>
        }

        @if (isSales)
        {
            <div class="vc-sidebar__section-label">SALES</div>
            <a class="vc-sidebar__link" asp-controller="Inquiry" asp-action="Index" aria-current="@Curr("Inquiry", "Index")"><span class="vc-sidebar__icon">📥</span> Inquiry Queue</a>
            @if (Can(Perm.SalesLeads))
            {
                <a class="vc-sidebar__link" asp-controller="Sales" asp-action="Leads" aria-current="@Curr("Sales", "Leads")"><span class="vc-sidebar__icon">🎯</span> Lead Tracker</a>
            }
            @if (Can(Perm.SalesMap))
            {
                <a class="vc-sidebar__link" asp-controller="Sales" asp-action="Map" aria-current="@Curr("Sales", "Map")"><span class="vc-sidebar__icon">🗺</span> Client Map</a>
            }
            @if (!Can(Perm.Workspace))
            {
                <a class="vc-sidebar__link" asp-controller="Pipeline" asp-action="Index" aria-current="@Curr("Pipeline", "Index")"><span class="vc-sidebar__icon">📊</span> Pipeline Board</a>
            }
            @if (Can(Perm.DashboardAnalytics))
            {
                <a class="vc-sidebar__link" asp-controller="Analytics" asp-action="Index" aria-current="@Curr("Analytics", "Index")"><span class="vc-sidebar__icon">📈</span> Analytics</a>
            }
            <a class="vc-sidebar__link" asp-controller="Quotation" asp-action="Index" aria-current="@Curr("Quotation", "Index")"><span class="vc-sidebar__icon">📄</span> Quotation Builder</a>
        }

        @if (Can(Perm.ProductCatalog))
        {
            <div class="vc-sidebar__section-label">CATALOG</div>
            <a class="vc-sidebar__link" asp-controller="Procurement" asp-action="ProductCatalog" aria-current="@Curr("Procurement", "ProductCatalog")"><span class="vc-sidebar__icon">📦</span> Product Catalog</a>
        }

        @if (isSupport || isProcurement)
        {
            <div class="vc-sidebar__section-label">SUPPORT</div>
            <a class="vc-sidebar__link" asp-controller="Support" asp-action="TicketHub" aria-current="@Curr("Support", "TicketHub")"><span class="vc-sidebar__icon">🎫</span> Ticket Hub</a>
            @* Same rule as Warehouse Alerts below: a Field Support Engineer holds
               support.dashboard, which is what put this section on their screen,
               but not logistics.tracker - so the link was a guaranteed 403. *@
            @if (Can(Perm.LogisticsTracker))
            {
                <a class="vc-sidebar__link" asp-controller="Logistics" asp-action="Tracker" aria-current="@Curr("Logistics", "Tracker")"><span class="vc-sidebar__icon">🚚</span> Logistics Tracker</a>
            }
        }

        @* Gated on the permission the action itself demands, not on the coarse
           "is procurement" flag: the link used to appear for a Procurement
           Manager who had never been granted warehouse.alerts, so clicking it
           was a guaranteed 403. *@
        @if (Can(Perm.WarehouseAlerts))
        {
            <div class="vc-sidebar__section-label">OPERATIONS</div>
            <a class="vc-sidebar__link" asp-controller="Procurement" asp-action="WarehouseAlerts" aria-current="@Curr("Procurement", "WarehouseAlerts")"><span class="vc-sidebar__icon">🏭</span> Warehouse Alerts</a>
        }

        @* Gated on the permission the action itself demands, for the same reason
           Warehouse Alerts is: Sales and Procurement can review an application, an
           administrator always can, and nobody else gets a link that ends in a 403. *@
        @if (Can(Perm.AccountApprovals))
        {
            <div class="vc-sidebar__section-label">ACCOUNTS</div>
            <a class="vc-sidebar__link" asp-controller="Admin" asp-action="Approvals" aria-current="@Curr("Admin", "Approvals")"><span class="vc-sidebar__icon">✔</span> Account Approvals</a>
            @* Same reviewers as the queue above, because the notes behind it are the
               applications that never reached it: somebody who cannot sign in has no
               way to say so from inside the system they are locked out of. *@
            <a class="vc-sidebar__link" asp-controller="Admin" asp-action="HelpRequests" aria-current="@Curr("Admin", "HelpRequests")"><span class="vc-sidebar__icon">☎</span> Sign-in Help</a>
        }

        @if (isAdmin)
        {
            <div class="vc-sidebar__section-label">ADMIN</div>
            <a class="vc-sidebar__link" asp-controller="Admin" asp-action="Users" aria-current="@Curr("Admin", "Users")"><span class="vc-sidebar__icon">👤</span> Users &amp; Roles</a>
            <a class="vc-sidebar__link" asp-controller="Admin" asp-action="Rules" aria-current="@Curr("Admin", "Rules")"><span class="vc-sidebar__icon">⚙</span> Rules Engine</a>
        }
    </nav>

    <div class="vc-sidebar__footer">
        @* Deliberately outside every `Can(...)` check: the notice is the document
           that says what this role is allowed to read, so it has to be readable by
           whoever holds that role. *@
        <a class="vc-sidebar__policy" href="/Home/Privacy">Privacy notice</a>
        <form asp-controller="Account" asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="vc-logout">→ Sign out</button>
        </form>
    </div>
</aside>
