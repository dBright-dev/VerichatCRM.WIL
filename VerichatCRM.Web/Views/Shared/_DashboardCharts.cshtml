@model VerichatCRM.Core.Models.Dashboard.DashboardAnalyticsResponse
@*
    The trend half that the administrator's home and the workspace board both
    show. It existed twice — the same three canvases, the same three JSON dumps,
    the same hand-written Chart.js config in each view's Scripts section, with
    the two copies free to drift apart. Now one partial, and the only thing a
    view adds is its own headline numbers, alert and panels around it.
    charts.js finds the payload below by id and draws all three; nothing here
    names a colour. Design-system doc 4.
*@
<div class="chart-grid">
    <div class="card">
        <div class="card-title">Order value · last six months</div>
        <div class="chart-card-canvas"><canvas id="revenueTrend" aria-label="Monthly order value trend" role="img"></canvas></div>
    </div>
    <div class="card">
        <div class="card-title">Order status mix · last six months</div>
        <div class="chart-card-canvas"><canvas id="statusBreakdown" aria-label="Order status breakdown" role="img"></canvas></div>
    </div>
</div>

<div class="card">
    <div class="card-title">Volume trends · last six months</div>
    <div class="chart-card-canvas"><canvas id="seriesChart" aria-label="Monthly volume trends" role="img"></canvas></div>
</div>

@* The default JSON encoder escapes <, > and &, so a label containing markup
   cannot break out of this script element. *@
<script type="application/json" id="vc-dashboard-charts">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
    {
        labels = Model.RevenueTrend.Select(p => p.Label).ToList(),
        revenue = new
        {
            label = "Order value (R)",
            data = Model.RevenueTrend.Select(p => p.Value).ToList()
        },
        status = new
        {
            labels = Model.Breakdown.Select(p => p.Label).ToList(),
            values = Model.Breakdown.Select(p => p.Value).ToList()
        },
        series = Model.Series.Select(s => new
        {
            label = s.Name,
            data = s.Points.Select(pt => pt.Value).ToList()
        }).ToList()
    }))
</script>
