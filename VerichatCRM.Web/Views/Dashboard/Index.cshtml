@model VerichatCRM.Core.Models.Dashboard.DashboardAnalyticsResponse
@{
    // Every staff role reaches this board, so it is the one dashboard that shows
    // no role's private work: the headline numbers the API already shapes per role,
    // plus the six-month trend everyone is measured against. The event log and the
    // admin controls are on /admin/dashboard, and each role's queue is on its own
    // home. Two "what happened" feeds on one screen was the redundancy here.
    // DESIGN-SYSTEM.md 4.
}

<div class="stat-grid">
    @foreach (var kpi in Model.Kpis)
    {
        <div class="stat-card">
            <div class="stat-label">@kpi.Label</div>
            <div class="stat-value vc-accent">@kpi.Value</div>
            @if (!string.IsNullOrEmpty(kpi.DeltaLabel))
            {
                <div class="stat-meta">@kpi.DeltaLabel</div>
            }
        </div>
    }
</div>

<partial name="_DashboardCharts" model="Model" />

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script src="~/js/charts.js"></script>
}
