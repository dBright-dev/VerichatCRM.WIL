@{
    // The published privacy notice. It is written against what this system actually
    // stores - the tables, the token design, the session cookie, the device storage -
    // rather than a generic template, because a notice that does not match the code is
    // worse than no notice at all.
    Layout = "_LandingLayout";
    ViewData["Title"] = "Privacy notice";
}

<section class="lnd-section lnd-section--top" id="notice">
    <div class="lnd-wrap">
        <div class="lnd-legal__masthead">
            <p class="lnd-kicker">Verichat Quality Projects · Legal</p>
            <h1 class="lnd-legal__title">Privacy notice</h1>
            <p class="lnd-legal__standfirst">
                Verichat runs the supply chain of a clinic, a mine rescue station or a
                teaching laboratory. To do that we hold names, addresses, delivery
                locations, equipment serial numbers and the dates a device was last
                calibrated. This notice says exactly what we hold, why we hold it, who
                inside our company is allowed to read it, and how you get it changed or
                removed.
            </p>

            <dl class="lnd-legal__meta">
                <div>
                    <dt>Version</dt>
                    <dd>1.0 · published 1 November 2026</dd>
                </div>
                <div>
                    <dt>Covers</dt>
                    <dd>The website, the signed-in portal, the API and the Verichat mobile app</dd>
                </div>
                <div>
                    <dt>Questions</dt>
                    <dd><a href="mailto:sales&#64;verichat.co.zw">sales&#64;verichat.co.zw</a></dd>
                </div>
            </dl>
        </div>

        <div class="lnd-legal__glance">
            <div class="lnd-legal__glance-item">
                <b>No advertising</b>
                <span>We do not sell your data, and we do not build an advertising profile of you.</span>
            </div>
            <div class="lnd-legal__glance-item">
                <b>No trackers</b>
                <span>No analytics or marketing pixels. One cookie, and it is only there to keep you signed in.</span>
            </div>
            <div class="lnd-legal__glance-item">
                <b>No plain-text passwords</b>
                <span>Your password is stored as a salted PBKDF2 hash. We could not read it back if somebody asked.</span>
            </div>
            <div class="lnd-legal__glance-item">
                <b>Access is a decision</b>
                <span>A registration is an application. A Verichat employee approves it before any data opens.</span>
            </div>
        </div>
    </div>
</section>

<div class="lnd-wrap"><hr class="lnd-hairline" /></div>

<section class="lnd-section lnd-section--close">
