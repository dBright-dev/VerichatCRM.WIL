@model VerichatCRM.Core.Models.Pipeline.PipelineBoardViewModel
@using VerichatCRM.Core.Models.Pipeline
@using VerichatCRM.Web.Models.Goals
@{
    var goal = ViewData["GoalProgress"] as GoalProgressViewModel ?? new GoalProgressViewModel();
}

<partial name="_GoalProgress" model="goal" />

<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="vc-card vc-kpi-card">
            <div class="vc-kpi-card__label">Total Pipeline</div>
            <div class="vc-kpi-card__value">@Model.TotalPipelineValue.ToString("C0")</div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="vc-card vc-kpi-card">
            <div class="vc-kpi-card__label">Weighted Forecast</div>
            <div class="vc-kpi-card__value">@Model.WeightedForecast.ToString("C0")</div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="vc-card vc-kpi-card">
            <div class="vc-kpi-card__label">Deals This Period</div>
            <div class="vc-kpi-card__value">@Model.DealsThisPeriod</div>
        </div>
    </div>
</div>

<div id="boardMessage" class="alert alert-danger d-none" role="alert"></div>

<div class="table-responsive pb-2">
    <div class="d-flex gap-3" style="min-width: 1100px;" id="pipelineBoard">
        @foreach (var stage in PipelineStages.All)
        {
            var deals = Model.DealsByStage.TryGetValue(stage, out var list) ? list : new();
            var stageTotal = deals.Sum(d => d.Value);
            var isOpenStage = stage != PipelineStages.ClosedWon && stage != PipelineStages.Lost;

            <div class="flex-fill" style="min-width: 210px;">
                <div class="vc-card p-2 h-100 pipeline-column"
                     data-stage="@stage"
                     ondrop="vcHandleDrop(event)" ondragover="vcAllowDrop(event)">

                    <div class="px-2 py-1 mb-2">
                        <div class="fw-semibold small">@stage</div>
                        <div class="vc-text-muted small">@deals.Count deals &middot; @stageTotal.ToString("C0")</div>
                    </div>

                    <div class="d-flex flex-column gap-2" data-stage-list="@stage">
                        @foreach (var deal in deals)
                        {
                            var stale = isOpenStage && FollowUpHelper.IsStale(deal.LastContactDate);

                            <div class="vc-card p-2 pipeline-card @(stale ? "border-start border-danger border-3" : "")"
                                 draggable="true"
                                 ondragstart="vcHandleDragStart(event)"
                                 data-deal-id="@deal.Id"
                                 tabindex="0"
                                 aria-label="@deal.ClientName, @deal.Value.ToString("C0"), assigned to @deal.AssignedRep, stage @stage">

                                <div class="fw-semibold small">@deal.ClientName</div>
                                <div class="vc-text-muted small mb-1">@deal.Value.ToString("C0")</div>
                                <div class="vc-text-muted small mb-1">
                                    @deal.AssignedRep
                                    @if (deal.ExpectedCloseDate.HasValue)
                                    {
                                        <span> &middot; @deal.ExpectedCloseDate.Value.ToString("dd MMM")</span>
                                    }
                                </div>

                                @if (isOpenStage)
                                {
                                    <div class="small mb-2 @(stale ? "text-danger fw-semibold" : "vc-text-muted")">
                                        Last Contact: @FollowUpHelper.Describe(deal.LastContactDate)@(stale ? " (Overdue!)" : "")
                                    </div>
                                }

                                <label class="visually-hidden" for="move-@deal.Id">Move @deal.ClientName to stage</label>
                                <select id="move-@deal.Id" class="form-select form-select-sm"
                                        onchange="vcMoveCard(this.closest('.pipeline-card').dataset.dealId, this.value)">
                                    @foreach (var s in PipelineStages.All)
                                    {
                                        <option value="@s" selected="@(s == stage)">@s</option>
                                    }
                                </select>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        const vcMoveUrl = '@Url.Action("MoveDeal", "Pipeline")';
        let vcDraggedId = null;

        function vcFindCard(dealId) {
            return [...document.querySelectorAll('.pipeline-card')]
                .find(c => c.dataset.dealId === dealId) || null;
        }

        function vcShowBoardMessage(text) {
            const el = document.getElementById('boardMessage');
            el.textContent = text;
            el.classList.remove('d-none');
            clearTimeout(window.__vcMsgTimer);
            window.__vcMsgTimer = setTimeout(() => el.classList.add('d-none'), 6000);
        }

        function vcHandleDragStart(e) {
            vcDraggedId = e.target.closest('.pipeline-card').dataset.dealId;
            e.dataTransfer.effectAllowed = 'move';
        }

        function vcAllowDrop(e) { e.preventDefault(); }

        function vcHandleDrop(e) {
            e.preventDefault();
            const column = e.target.closest('.pipeline-column');
            if (!column || vcDraggedId === null) return;
            vcMoveCard(vcDraggedId, column.dataset.stage);
        }

        async function vcMoveCard(dealId, targetStage) {
            const card = vcFindCard(dealId);
            const targetList = document.querySelector(`[data-stage-list="${targetStage}"]`);
            if (!card || !targetList) return;

            const originList = card.parentElement;
            if (originList === targetList) return;

            const select = card.querySelector('select');

            // Optimistic UI update
            targetList.appendChild(card);
            if (select) select.value = targetStage;

            try {
                const res = await fetch(vcMoveUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ dealId, newStage: targetStage })
                });
                if (!res.ok) throw new Error('Status ' + res.status);
            } catch (err) {
                // Put the card back so the board never shows an unsaved move
                originList.appendChild(card);
                if (select) select.value = originList.dataset.stageList;
                vcShowBoardMessage('Could not move that deal. It was returned to its previous stage.');
            }
        }
    </script>
}