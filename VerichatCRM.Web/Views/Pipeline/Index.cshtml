@model VerichatCRM.Core.Models.Pipeline.PipelineBoardViewModel

<div id="appointmentToast" role="status" aria-live="polite" style="display:none;position:fixed;right:22px;top:22px;z-index:2000;background:#102b46;color:white;padding:14px 18px;border-radius:12px;box-shadow:0 8px 30px #0003"></div>

@if (ViewBag.MobileQuoteRequests is IEnumerable<VerichatCRM.Web.Models.Quotation.QuotationDto> mobileQuotes && mobileQuotes.Any())
{
    <section class="vc-card p-3 mb-4" id="mobileQuoteRequests">
        <div class="d-flex justify-content-between align-items-center mb-2"><h2 class="h5 mb-0">Mobile quote requests</h2><span class="badge bg-primary">@mobileQuotes.Count()</span></div>
        @if (TempData["MobileQuoteMessage"] is string quoteMessage) { <div class="alert alert-info">@quoteMessage</div> }
        <div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Client</th><th>Quote</th><th>Requested items</th><th>Estimate</th><th>Received</th><th>Review</th></tr></thead><tbody>
        @foreach (var quote in mobileQuotes)
        {
            <tr><td>@quote.ClientName</td><td>@quote.QuoteReference</td><td>@string.Join(", ", quote.LineItems.Select(line => $"{line.ProductName} × {line.Quantity}"))</td><td>@quote.GrandTotal.ToString("C2")</td><td>@quote.DateGenerated.ToLocalTime().ToString("d MMM HH:mm")</td><td><span class="badge bg-secondary">@quote.Status</span>@if (quote.Status is "Draft" or "Reviewed") { <form asp-controller="Quotation" asp-action="AdvanceMobileRequest" method="post" class="mt-2">@Html.AntiForgeryToken()<input type="hidden" name="quotationId" value="@quote.QuotationId"/><input type="hidden" name="status" value="@(quote.Status == "Draft" ? "Reviewed" : "Sent")"/><button class="btn btn-sm btn-outline-primary">@(quote.Status == "Draft" ? "Mark reviewed" : "Send to client")</button></form> }</td></tr>
        }
        </tbody></table></div>
    </section>
}

<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="vc-card vc-kpi-card">
            <div class="vc-kpi-card__label">Total Pipeline</div>
            <div class="vc-kpi-card__value">@Model.TotalPipelineValue.ToString("C0")</div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="vc-card vc-kpi-card">
            <div class="vc-kpi-card__label">Weighted Forecast</div>
            <div class="vc-kpi-card__value">@Model.WeightedForecast.ToString("C0")</div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="vc-card vc-kpi-card">
            <div class="vc-kpi-card__label">Deals This Period</div>
            <div class="vc-kpi-card__value">@Model.DealsThisPeriod</div>
        </div>
    </div>
</div>

<div class="table-responsive pb-2">
    <div class="d-flex gap-3" style="min-width: 1100px;" id="pipelineBoard">
        @foreach (var stage in VerichatCRM.Core.Models.Pipeline.PipelineStages.All)
        {
            var deals = Model.DealsByStage.TryGetValue(stage, out var list) ? list : new();
            var stageTotal = deals.Sum(d => d.Value);

            <div class="flex-fill" style="min-width: 210px;">
                <div class="vc-card p-2 h-100 pipeline-column"
                     data-stage="@stage"
                     ondrop="vcHandleDrop(event)" ondragover="vcAllowDrop(event)">

                    <div class="px-2 py-1 mb-2">
                        <div class="fw-semibold small">@stage</div>
                        <div class="vc-text-muted small">@deals.Count deals &middot; @stageTotal.ToString("C0")</div>
                    </div>

                    <div class="d-flex flex-column gap-2" data-stage-list="@stage">
                        @foreach (var deal in deals)
                        {
                            <div class="vc-card p-2 pipeline-card"
                                 draggable="true"
                                 ondragstart="vcHandleDragStart(event)"
                                 data-deal-id="@deal.Id"
                                 tabindex="0"
                                 aria-label="@deal.ClientName, @deal.Value.ToString("C0"), assigned to @deal.AssignedRep, stage @stage">

                                <div class="fw-semibold small">@deal.ClientName</div>
                                <div class="vc-text-muted small mb-1">@deal.Value.ToString("C0")</div>
                                <div class="vc-text-muted small mb-2">
                                    @deal.AssignedRep
                                    @if (deal.ExpectedCloseDate.HasValue)
                                    {
                                        <span> &middot; @deal.ExpectedCloseDate.Value.ToString("dd MMM")</span>
                                    }
                                </div>

                                <label class="visually-hidden" for="move-@deal.Id">Move @deal.ClientName to stage</label>
                                <select id="move-@deal.Id" class="form-select form-select-sm"
                                        onchange="vcMoveCard(@deal.Id, this.value)">
                                    @foreach (var s in VerichatCRM.Core.Models.Pipeline.PipelineStages.All)
                                    {
                                        <option value="@s" selected="@(s == stage)">@s</option>
                                    }
                                </select>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        let vcDraggedId = null;

        function vcHandleDragStart(e) {
            vcDraggedId = e.target.closest('.pipeline-card').dataset.dealId;
            e.dataTransfer.effectAllowed = 'move';
        }

        function vcAllowDrop(e) { e.preventDefault(); }

        function vcHandleDrop(e) {
            e.preventDefault();
            const column = e.target.closest('.pipeline-column');
            if (!column || vcDraggedId === null) return;
            vcMoveCard(vcDraggedId, column.dataset.stage);
        }

        async function vcMoveCard(dealId, targetStage) {
            const card = document.querySelector(`.pipeline-card[data-deal-id="${dealId}"]`);
            const targetList = document.querySelector(`[data-stage-list="${targetStage}"]`);
            if (!card || !targetList) return;

            // Optimistic UI update
            targetList.appendChild(card);
            const select = card.querySelector('select');
            if (select) select.value = targetStage;

            // Persist to API via the web proxy
            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                const res = await fetch('/pipeline/move-deal', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token ?? '' },
                    body: JSON.stringify({ dealId, newStage: targetStage })
                });
                if (!res.ok) console.warn('Failed to persist stage change');
            } catch (err) {
                console.error(err);
            }
        }
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js" referrerpolicy="no-referrer"></script>
    <script>window.verichatSignalR={baseUrl:@Html.Raw(System.Text.Json.JsonSerializer.Serialize((string?)ViewBag.ApiBaseUrl)),token:@Html.Raw((string)ViewBag.ApiToken)};</script>
    <script src="~/js/signalr.js" asp-append-version="true"></script>
}
